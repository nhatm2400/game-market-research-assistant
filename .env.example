# Sao chép file này thành .env rồi điền khóa. File .env không được đưa lên GitHub.
GEMINI_API_KEY=
# Không bắt buộc. Không có thì dùng DuckDuckGo.
TAVILY_API_KEY=
# Không bắt buộc. Đổi mô hình nếu bị giới hạn lượt gọi, ví dụ gemini-2.5-flash-lite
LLM_MODEL=gemini-2.5-flash
# Không bắt buộc. Mô hình dự phòng khi mô hình chính quá tải (503), cách nhau bằng dấu phẩy
LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
